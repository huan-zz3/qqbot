# NapCat OneBot v11 正向 WebSocket（NapCat 做服务端，bot 做客户端）
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
# 两条消息之间的最小发送间隔，防止触发风控
NAPCAT_SEND_INTERVAL_MS=800

# 网络代理：填 HTTP 代理地址则所有联网请求（DeepSeek、联网搜索、图片下载）都走它；留空则直连
PROXY_URL=

# 机器人
BOT_NAME=小猫
# 群友对机器人的其他称呼，逗号分隔
BOT_ALIASES=
BOT_PERSONA=是群里的一个 AI 群友。
# 追加式人设文件：把该文件内容拼到上面 BOT_PERSONA 之后；支持相对路径（相对进程启动目录）。
# 文件读不到会直接报错退出（不静默回退）。留空则只用 BOT_PERSONA。
BOT_PERSONA_FILE=
# 启用的群号，逗号分隔；为空时不在任何群发言
BOT_GROUPS=
# 允许私聊的 QQ 号，逗号分隔；为空时不回任何私聊
BOT_PRIVATE_USERS=
# 管理员 QQ 号：在私聊里发 /启动 /停止 控制 bot 是否参与聊天（状态存在 BOT_STATE_FILE，重启不丢）
BOT_ADMIN_USERS=
BOT_STATE_FILE=data/state.json

# decider（通用判定接口）：决定该不该发言、要不要给 DeepSeek 挂上联网搜索
# 端点/密钥/模型全部在这里配置，代码只写死通用接口；以 Perplexity Decisions API 为例：
DECIDER_API_URL=https://api.perplexity.ai/v1/decisions
DECIDER_API_KEY=
DECIDER_MODEL=pplx-decider-v1.1-27b
DECIDER_TIMEOUT_MS=5000

# 判断阈值：decider 给出的“该回复”概率达到阈值才发言
GATE_GROUP_THRESHOLD=0.6
GATE_PRIVATE_THRESHOLD=0.35
# 被 @ 或被回复时的阈值（仍由 decider 判断，“哈哈哈”之类的可以不回）
GATE_DIRECT_THRESHOLD=0.45
# 名单里的 QQ 被 @ 或被回复时视同 bot 自己，也走上面这个 direct 阈值（防抖同样按 direct 处理）；逗号分隔，为空不启用
GATE_DIRECT_USERS=
# decider 的 needs_search 高于这个值就挂上联网搜索工具，搜不搜由 DeepSeek 决定
GATE_SEARCH_THRESHOLD=0.1
# 自定义「什么情况下该回复」提示词：分别追加到 decider should_reply 问题的正文、true/false 判定标准之后；留空不追加
GATE_REPLY_QUESTION_PROMPT=
GATE_REPLY_TRUE_PROMPT=
GATE_REPLY_FALSE_PROMPT=
# 等消息停下来再判断，把连续几条合并成一批
GATE_GROUP_DEBOUNCE_MS=3000
GATE_PRIVATE_DEBOUNCE_MS=1500
GATE_DIRECT_DEBOUNCE_MS=800
GATE_MAX_WAIT_MS=10000

# 累计强制回复：对下面名单里的群，各自累计「自上次发言以来的群消息数」，达到条数后下一次判断强制回复一次
# （跳过回复阈值，搜索建议仍由 decider 给出）；机器人发言 / 强制判定 / /停止 时清零
# 启用时 GATE_FORCE_REPLY_GROUPS 必须非空、都在 BOT_GROUPS 内，且条数为正，否则启动即报错退出
GATE_FORCE_REPLY_ENABLED=false
GATE_FORCE_REPLY_GROUPS=
GATE_FORCE_REPLY_MESSAGES=20

# DeepSeek（固定使用 deepseek-flash）
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING=false
# 只用于生成回复；1.3 会冒出奇怪的外文标点和单词
DEEPSEEK_TEMPERATURE=1.1
DEEPSEEK_MAX_TOKENS=800
# 工具轮数（联网搜索与 opencode 共用）；用尽后不再挂工具，并追加一条收尾指令要求纯文本作答
DEEPSEEK_MAX_TOOL_ROUNDS=3

# 联网搜索：连一个远程 MCP 服务器（streamable HTTP），把它暴露的全部工具挂给模型，无常驻凭证
SEARCH_MCP_ENABLED=true
SEARCH_MCP_URL=https://openwebsearch.xxx.xx/mcp #https://github.com/Aas-ee/open-webSearch
# 连接与单次工具调用的超时（毫秒）
SEARCH_MCP_TIMEOUT_MS=30000
# 断连后自动重连：首次间隔与指数退避（×2）的封顶（毫秒）
SEARCH_MCP_RECONNECT_MIN_MS=5000
SEARCH_MCP_RECONNECT_MAX_MS=60000

# 只读 OpenCode（ACP）：让模型在固定仓库里检索/阅读代码并回答；权限一律拒绝，不能改文件、跑命令
# 前提：服务器上装好 opencode 并执行过 `opencode auth login`（用它自己的登录态，与本项目的 MCP 联网搜索无关）
OPENCODE_ENABLED=false
OPENCODE_COMMAND=opencode
# 启动参数，默认 acp
OPENCODE_ARGS=acp
# 提示词里给模型的 opencode 说明，用来框定「什么情况下该调用」；留空用默认说明
OPENCODE_PROMPT=
# 允许访问的仓库绝对路径；启用时留空或不是已存在的目录会在启动时报错退出
OPENCODE_CWD=
# 给 ACP 会话指定的模型（provider/model，如 deepseek/deepseek-flash）；留空用 opencode 自己的默认（可能很贵）
OPENCODE_MODEL=
# opencode 开始执行时先发出的一条提示文本（例如“正在查看，请稍等…”）；留空则不发
OPENCODE_NOTICE_TEXT=
# 单次任务总超时（超时会先取消再杀掉子进程）
OPENCODE_TIMEOUT_MS=180000
# 返回文本的截断上限
OPENCODE_MAX_OUTPUT_CHARS=4000

# 表情包：收藏群友发的表情包，deepseek-flash 识图描述
STICKERS_ENABLED=true
STICKERS_DIR=data/stickers
STICKERS_MAX=300
STICKERS_PROMPT_LIMIT=40

# 普通图片：deepseek-flash 识图后以 [图片：描述] 出现在聊天记录里（不保存）
IMAGES_ENABLED=true
IMAGES_MAX_BYTES=8388608

# 聊天文件：收到文件时聊天记录显示为 [文件：名（大小）]；模型调用 opencode 时把发言者最近发来的
# 文本类文件懒下载并作为上下文一并交给它（只支持 txt/md/log 等文本类，二进制/Office 等无法读取）
FILES_ENABLED=true
# 单文件下载上限（字节）
FILES_MAX_BYTES=5242880
# 单文件注入 opencode 的字符上限，超出截断
FILES_MAX_CHARS=20000
# 单次 opencode 最多注入几个文件
FILES_MAX_FILES=3

# 长期记忆：bot 回复后等对话停下再整理，或未整理的消息攒够一批时整理
MEMORY_ENABLED=true
MEMORY_FILE=data/memory.json
MEMORY_LEARN_DELAY_MS=10000
MEMORY_LEARN_BATCH=30
# 攒批整理只在 bot 这段时间内说过话的会话里进行，不去记从没跟它互动过的人
MEMORY_ENGAGED_WINDOW_MS=1800000
MEMORY_MAX_FACTS=20

# 群管理：decider 三问决定撤回/禁言/回复（各自独立触发、无优先级；执行顺序 撤回 → 禁言 → 回复），每项配置留空即不启用
# 只对 MODERATION_GROUPS 里的群生效，且机器人必须是该群 owner/admin，否则日志报错并跳过
MODERATION_ENABLED=false
MODERATION_GROUPS=
# 判断一条消息时，附带它前面这么多条群消息作为上下文
MODERATION_CONTEXT_MESSAGES=5
# 群管理命中后是否跳过同一批消息的 AI 回复（默认开启）
MODERATION_SKIP_REPLY=true
# 撤回：达到阈值先 delete_msg，再 @ 对方发固定文本
MODERATION_RECALL_PROMPT=
MODERATION_RECALL_THRESHOLD=0.85
MODERATION_RECALL_TEXT=
# 禁言：达到阈值先 set_group_ban 对方，再 @ 对方发固定文本
MODERATION_BAN_PROMPT=
MODERATION_BAN_THRESHOLD=0.9
MODERATION_BAN_TEXT=
MODERATION_BAN_SECONDS=600
# 回复：达到阈值只 @ 对方发固定文本
MODERATION_REPLY_PROMPT=
MODERATION_REPLY_THRESHOLD=0.8
MODERATION_REPLY_TEXT=

# 入群欢迎：新成员入群时 @ 其发送 WELCOME_TEXT；独立于群管理，自带群组范围，受 /启动 /停止 约束
# 启用时 WELCOME_GROUPS / WELCOME_TEXT 任一为空，启动即报错退出（不会静默不发）
WELCOME_ENABLED=false
WELCOME_GROUPS=
WELCOME_TEXT=

# 定时群发：按一条 cron（时区固定 Asia/Shanghai）到点向指定群各发一条固定纯文本；受 /启动 /停止 约束
# cron 非法或任一必填项为空时，启动即报错退出（不会静默不发）
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * *
SCHEDULE_GROUPS=
SCHEDULE_TEXT=

# 回复超过这么多行或字，就把正文打包成一条合并转发，免得刷屏
REPLY_FORWARD_PARTS=5
REPLY_FORWARD_CHARS=300
# 只防失控输出的上限，提示词里不限制长度
REPLY_MAX_CHARS=1500
REPLY_MAX_PARTS=40
HISTORY_CONTEXT_MESSAGES=40
LOG_LEVEL=info
