# NapCat OneBot v11 正向 WebSocket（NapCat 做服务端，bot 做客户端）
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=
# 两条消息之间的最小发送间隔，防止触发风控
NAPCAT_SEND_INTERVAL_MS=800

# 网络代理：填 HTTP 代理地址则所有联网请求（DeepSeek、联网搜索、图片下载）都走它；留空则直连
PROXY_URL=

# 机器人
BOT_NAME=小猫
# 群友对机器人的其他称呼，逗号分隔
BOT_ALIASES=
# 内联身份：接在回复提示词的“你是「名字」，…”后面；留空则只有名字（代码不再内置默认人设）。
BOT_PERSONA=是群里的一个 AI 群友。
# 行为准则文件：内容作为回复提示词的独立“必须遵守的人设与行为准则”段落，不与身份句混写；
# 支持相对路径（相对进程启动目录）。文件读不到会直接报错退出（不静默回退）。留空则没有准则段。
BOT_PERSONA_FILE=
# 启用的群号，逗号分隔；为空时不在任何群发言
BOT_GROUPS=
# 允许私聊的 QQ 号，逗号分隔；为空时不回任何私聊
BOT_PRIVATE_USERS=
# 管理员 QQ 号：在私聊里发 /启动 /停止 控制 bot 是否参与聊天（状态存在 BOT_STATE_FILE，重启不丢）
BOT_ADMIN_USERS=
BOT_STATE_FILE=data/state.json

# decider（通用判定接口）：决定该不该发言、要不要给 DeepSeek 挂上联网搜索
# 端点/密钥/模型全部在这里配置，代码只写死通用接口；以 Perplexity Decisions API 为例：
DECIDER_API_URL=https://api.perplexity.ai/v1/decisions
# 可配多个密钥（逗号/空白分隔），按顺序为优先级：某个失败就换下一个，成功者提升为最高优先级（仅进程内存）
DECIDER_API_KEY=
DECIDER_MODEL=pplx-decider-v1.1-27b
DECIDER_TIMEOUT_MS=5000

# 判断阈值：decider 给出的“该回复”概率达到阈值才发言
GATE_GROUP_THRESHOLD=0.6
GATE_PRIVATE_THRESHOLD=0.35
# 被 @ 或被回复时的阈值（仍由 decider 判断，“哈哈哈”之类的可以不回）
GATE_DIRECT_THRESHOLD=0.45
# 名单里的 QQ 被 @ 或被回复时视同 bot 自己，也走上面这个 direct 阈值（防抖同样按 direct 处理）；逗号分隔，为空不启用
GATE_DIRECT_USERS=
# decider 的 needs_search 高于这个值就挂上联网搜索工具，搜不搜由 DeepSeek 决定
GATE_SEARCH_THRESHOLD=0.1
# 自定义「什么情况下该回复」提示词：分别追加到 decider should_reply 问题的正文、true/false 判定标准之后；留空不追加
GATE_REPLY_QUESTION_PROMPT=
GATE_REPLY_TRUE_PROMPT=
GATE_REPLY_FALSE_PROMPT=
# 等消息停下来再判断，把连续几条合并成一批
GATE_GROUP_DEBOUNCE_MS=3000
GATE_PRIVATE_DEBOUNCE_MS=1500
GATE_DIRECT_DEBOUNCE_MS=800
GATE_MAX_WAIT_MS=10000

# 累计强制回复：对下面名单里的群，各自累计「自上次发言以来的群消息数」，达到条数后下一次判断强制回复一次
# （跳过回复阈值，搜索建议仍由 decider 给出）；机器人发言 / 强制判定 / /停止 时清零
# 启用时 GATE_FORCE_REPLY_GROUPS 必须非空、都在 BOT_GROUPS 内，且条数为正，否则启动即报错退出
GATE_FORCE_REPLY_ENABLED=false
GATE_FORCE_REPLY_GROUPS=
GATE_FORCE_REPLY_MESSAGES=20

# 回复 DeepSeek（固定使用 deepseek-flash，只用于生成回复）
DEEPSEEK_API_KEY=
DEEPSEEK_THINKING=false
# 只用于生成回复；1.3 会冒出奇怪的外文标点和单词
DEEPSEEK_TEMPERATURE=1.1
DEEPSEEK_MAX_TOKENS=800

# 图像识别（视觉理解）：与回复模型分开的独立后端，模型与端点写死在代码（SiliconFlow 的 deepseek-ai/DeepSeek-OCR）
# 仅当 IMAGES_ENABLED 开启，或 STICKERS_ENABLED 且 STICKERS_RECOGNIZE_ENABLED 开启时才必填，否则启动即报错退出（不会静默失效）
VISION_API_KEY=
# 传给 image_url 的细节级别：low / high / auto
VISION_DETAIL=high
# 请求超时（毫秒）与输出上限；超时须小于媒体补全等待上限（runtime 内 MEDIA_WAIT_MS=35000），否则启动报错退出
VISION_TIMEOUT_MS=30000
VISION_MAX_TOKENS=512

# 联网搜索：连一个远程 MCP 服务器（streamable HTTP），把它暴露的全部工具挂给模型，无常驻凭证
SEARCH_MCP_ENABLED=true
SEARCH_MCP_URL=https://openwebsearch.xxx.xx/mcp #https://github.com/Aas-ee/open-webSearch
# 连接与单次工具调用的超时（毫秒）
SEARCH_MCP_TIMEOUT_MS=30000
# 断连后自动重连：首次间隔与指数退避（×2）的封顶（毫秒）
SEARCH_MCP_RECONNECT_MIN_MS=5000
SEARCH_MCP_RECONNECT_MAX_MS=60000
# 联网搜索组的工具轮数上限；与 opencode 组各自独立计数（某组用尽只撤该组）
SEARCH_MAX_TOOL_ROUNDS=3

# 只读 OpenCode（ACP）：让模型在固定仓库里检索/阅读代码并回答；权限一律拒绝，不能改文件、跑命令
# 前提：服务器上装好 opencode 并执行过 `opencode auth login`（用它自己的登录态，与本项目的 MCP 联网搜索无关）
OPENCODE_ENABLED=false
OPENCODE_COMMAND=opencode
# 启动参数，默认 acp
OPENCODE_ARGS=acp
# 提示词里给模型的 opencode 说明，用来框定「什么情况下该调用」；留空用默认说明
OPENCODE_PROMPT=
# 允许访问的主仓库绝对路径，短名固定为 default；与 OPENCODE_DIRS 至少配一个
OPENCODE_CWD=
# 追加仓库列表，每项「短名=绝对路径」用逗号/空格分隔（路径不能含空格/逗号）
# 例：OPENCODE_DIRS=web=/srv/web blog=/srv/blog
OPENCODE_DIRS=
# 给 ACP 会话指定的模型（provider/model，如 deepseek/deepseek-flash）；留空用 opencode 自己的默认（可能很贵）
OPENCODE_MODEL=
# opencode 开始执行时先发出的一条提示文本（例如“正在查看，请稍等…”）；留空则不发
OPENCODE_NOTICE_TEXT=
# 自定义文本，拼进送进 `opencode acp` 的 prompt：前置拼在任务前、后置拼在任务后；各留空则不拼
# 注意与上面的 OPENCODE_PROMPT（给回复模型看的工具说明，不进 acp）不是一回事
OPENCODE_INPUT_PREFIX=
OPENCODE_INPUT_SUFFIX=
# 单次任务总超时（超时会先取消再杀掉子进程）
OPENCODE_TIMEOUT_MS=180000
# prompt 阶段允许的「无响应」静默时长：过久即判定 opencode 卡死并取消（须为正且小于总超时）
OPENCODE_IDLE_TIMEOUT_MS=60000
# 容忍的模型重试次数：opencode 上报的重试次数超过它即提前取消（须为正）
OPENCODE_RETRY_MAX=2
# 返回文本的截断上限
OPENCODE_MAX_OUTPUT_CHARS=4000
# 全局同时运行的任务数上限：同一会话始终串行，跨会话最多这么多并发（须为正整数）
OPENCODE_MAX_CONCURRENCY=3
# opencode 组的工具轮数上限；与联网搜索组各自独立计数（某组用尽只撤该组）
OPENCODE_MAX_TOOL_ROUNDS=3

# 表情包：收藏群友发的表情包，识图模型（SiliconFlow DeepSeek-OCR）写一句描述
STICKERS_ENABLED=true
# 是否识别并收藏新表情（下载 + 识图 + 入库，含把归档表情提升回活跃）
# 总开关开启时有效；设为 false 后只读现有库：老表情照常展示与发送，新表情不下载、不识图，
# 适合「积累够了、不想再轮换新表情」的场景（关掉后无需 VISION_API_KEY 也能用表情包发送）
STICKERS_RECOGNIZE_ENABLED=true
STICKERS_DIR=data/stickers
STICKERS_MAX=300
# 淘汰后保留描述的归档上限（无文件；再次出现时复用描述、不重新识图）
STICKERS_ARCHIVE_MAX=2000
STICKERS_PROMPT_LIMIT=40

# 普通图片：识图模型识别后以 [图片：描述] 出现在聊天记录里（不保存）
IMAGES_ENABLED=true
IMAGES_MAX_BYTES=8388608

# 聊天压缩包：群友发来的 .zip/.rar 会被下载解压到本地目录，并把「目录 + 文件清单」交给回复模型
# （模型可让 opencode 去读这些目录）。只认 zip/rar；松散文本文件不再支持，请群友自行打包。
# 物料化与 OPENCODE_ENABLED 解耦：由 FILES_MATERIALIZE 单独控制（关掉则不下载解压）。
FILES_ENABLED=true
FILES_MATERIALIZE=true
# 解压根目录（data/ 已被 gitignore 忽略）
FILES_DIR=data/uploads
# 单个压缩包下载上限（字节），流式边读边限
FILES_MAX_BYTES=52428800
# 单批最多处理几个压缩包
FILES_MAX_FILES=3
# 单包解压后总字节 / 条目数 / 单文件字节上限
FILES_EXTRACT_MAX_BYTES=209715200
FILES_EXTRACT_MAX_ENTRIES=1000
FILES_EXTRACT_MAX_FILE_BYTES=52428800
# 解压目录保留时长（毫秒），及磁盘总预算（字节，超出按最旧优先清理）
FILES_KEEP_MS=86400000
FILES_STORE_MAX_BYTES=1073741824
# 清理扫描间隔（毫秒）
FILES_SWEEP_MS=3600000
# 单个压缩包下载超时（毫秒）
FILES_TIMEOUT_MS=120000
# 给模型的压缩包处理说明（执行逻辑：何时算成功/失败、失败要如实转告等）；留空用内置默认
FILES_PROMPT=聊天记录里的 [文件：…] 是群友发来的压缩包。系统会尝试在本地解压它：成功时清单会给出目录与文件；无法解压或读取失败时，清单里会写明原因，请把原因如实告诉发文件的群友。图片、音视频、Office 文档等其他类型无法读取，可让对方打包成 zip 或 rar 再发。
# 仅在挂了 opencode 工具时追加的「怎么读解压目录」说明；留空用内置默认
FILES_READ_PROMPT=需要查看压缩包里的内容时，可调用 opencode 读取清单里给出的解压目录。

# 长期记忆：只在 bot 实际回复后整理，范围为触发该次回复的那批消息；延迟窗内的多次回复合并为一次
MEMORY_ENABLED=true
MEMORY_FILE=data/memory.json
MEMORY_LEARN_DELAY_MS=10000
MEMORY_MAX_FACTS=20

# 群管理：decider 三问决定撤回/禁言/回复（各自独立触发、无优先级；执行顺序 撤回 → 禁言 → 回复），每项配置留空即不启用
# 只对 MODERATION_GROUPS 里的群生效，且机器人必须是该群 owner/admin，否则日志报错并跳过
MODERATION_ENABLED=false
MODERATION_GROUPS=
# 判断一条消息时，附带它前面这么多条群消息作为上下文
MODERATION_CONTEXT_MESSAGES=5
# 群管理命中后是否跳过同一批消息的 AI 回复（默认开启）
MODERATION_SKIP_REPLY=true
# 撤回：达到阈值先 delete_msg，再 @ 对方发固定文本
MODERATION_RECALL_PROMPT=
MODERATION_RECALL_THRESHOLD=0.85
MODERATION_RECALL_TEXT=
# 禁言：达到阈值先 set_group_ban 对方，再 @ 对方发固定文本
MODERATION_BAN_PROMPT=
MODERATION_BAN_THRESHOLD=0.9
MODERATION_BAN_TEXT=
MODERATION_BAN_SECONDS=600
# 回复：达到阈值只 @ 对方发固定文本
MODERATION_REPLY_PROMPT=
MODERATION_REPLY_THRESHOLD=0.8
MODERATION_REPLY_TEXT=

# 入群欢迎：新成员入群时 @ 其发送 WELCOME_TEXT；独立于群管理，自带群组范围，受 /启动 /停止 约束
# 启用时 WELCOME_GROUPS / WELCOME_TEXT 任一为空，启动即报错退出（不会静默不发）
WELCOME_ENABLED=false
WELCOME_GROUPS=
WELCOME_TEXT=

# 定时群发：按一条 cron（时区固定 Asia/Shanghai）到点向指定群各发一条固定纯文本；受 /启动 /停止 约束
# cron 非法或任一必填项为空时，启动即报错退出（不会静默不发）
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 8 * * *
SCHEDULE_GROUPS=
SCHEDULE_TEXT=

# 定时执行本地 shell 命令（多条）：每条 EXEC_<n>_CRON + EXEC_<n>_SHELL 成对填写，n 从 1 起、允许跳号
# 到点经 /bin/sh 在本机执行，只写日志；不发消息、不进聊天/记忆，也不受 /启动 /停止 约束（时区固定 Asia/Shanghai）
# 启用时任务数为 0、成对变量缺一、或 cron 非法，都会在启动时报错退出（不会静默不执行）
# 示例（按需取消注释）：
# EXEC_1_CRON=0 8 * * *
# EXEC_1_SHELL=/home/xxx/backup.sh
# EXEC_2_CRON=30 3 * * *
# EXEC_2_SHELL=echo hello
EXEC_ENABLED=false
# 单条命令执行超时（毫秒），超时终止子进程
EXEC_TIMEOUT_MS=60000
# 日志里每条命令 stdout/stderr 的截断上限（字符）
EXEC_MAX_OUTPUT_CHARS=2000

# 回复超过这么多行或字，就把正文打包成一条合并转发，免得刷屏
REPLY_FORWARD_PARTS=5
REPLY_FORWARD_CHARS=300
# 只防失控输出的上限，提示词里不限制长度
REPLY_MAX_CHARS=1500
REPLY_MAX_PARTS=40
# 每个会话保留的聊天记录上限
HISTORY_MAX_MESSAGES=100
# 给模型看的共享最近消息条数（所有会话成员共用）
HISTORY_CONTEXT_MESSAGES=40
# 本批每个发言群友各自额外保证纳入的最近消息条数（叠加在共享窗口之上，刷屏者的内容更完整）
HISTORY_USER_CONTEXT_MESSAGES=20
# 给 decider 看的共享最近消息条数（与模型窗口分开配置）
DECIDER_CONTEXT_MESSAGES=40
# decider 窗口对本批每个发言群友各自额外保证纳入的最近消息条数（叠加在共享窗口之上；默认 0 与拆分前一致）
DECIDER_USER_CONTEXT_MESSAGES=0
LOG_LEVEL=info
