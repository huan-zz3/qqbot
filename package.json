{
  "name": "qqbot",
  "private": true,
  "version": "0.1.0",
  "description": "QQ chat bot on NapCat: decider decides when to speak, deepseek-flash decides what to say",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mist-wu/qqbot.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-sea.mjs",
    "build:js": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "learn-history": "node dist/cli/learn-history.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cron": "^4.4.0",
    "dotenv": "^16.6.1",
    "node-unrar-js": "^2.0.2",
    "undici": "^8.11.2",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
